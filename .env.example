# Copia este archivo a .env.local y ajusta los valores.
# Las variables expuestas al cliente DEBEN llevar el prefijo VITE_.
# NUNCA pongas secretos (API keys privadas, tokens de DB) en variables VITE_,
# porque quedan visibles en el bundle del navegador.

# Driver de almacenamiento: "local" (localStorage) | "api" (backend REST)
VITE_STORAGE_DRIVER=local

# URL base del backend (solo si VITE_STORAGE_DRIVER=api)
VITE_API_BASE_URL=https://api.tu-dominio.com

# Proveedor de geocodificación: "nominatim" (default) | "mapbox" (a implementar)
VITE_GEOCODER=nominatim

# REQUERIDO — Token público de Mapbox GL JS.
# Obtenlo en https://account.mapbox.com → "Access tokens" → "Default public token".
VITE_MAPBOX_TOKEN=tu_token_de_mapbox_aqui

# Opcional — Estilo del mapa Mapbox. Si se omite, usa light-v11.
# Opciones disponibles:
#   mapbox://styles/mapbox/light-v11      (claro, recomendado)
#   mapbox://styles/mapbox/dark-v11       (oscuro)
#   mapbox://styles/mapbox/streets-v12    (callejero)
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Idioma por defecto: "es" | "en"
VITE_DEFAULT_LOCALE=es
