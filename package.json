{
  "name": "travel-routes-app",
  "version": "0.1.0",
  "description": "Aplicación global de seguimiento de rutas de viaje y control de gastos. Arquitectura modular lista para escalar y migrar a móvil (iOS/Android).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test",
    "generate:rules:gate-g-read": "node scripts/generateFirestoreGateGReadRules.mjs",
    "generate:rules:phase-k-e2e": "node scripts/generateFirestorePhaseKE2ERules.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test --test-concurrency=1 firebase-tests/firestore.rules.spec.js firebase-tests/internalCollections.rules.spec.js firebase-tests/firestore.v4.rules.spec.js firebase-tests/firestore.v4.internal.rules.spec.js firebase-tests/firestore.v4.repository.spec.js firebase-tests/firestore.v4.sync.spec.js firebase-tests/firestore.hybrid.rollout.spec.js firebase-tests/firestore.gate-g-read.rules.spec.js functions/v4AggregateStore.emulator.spec.js functions/v4TripLifecycleStore.emulator.spec.js functions/v4TripPurgeStore.emulator.spec.js functions/v4MigrationStore.emulator.spec.js functions/v4MigrationRollback.emulator.spec.js functions/v4MigrationLegacyV2.emulator.spec.js\"",
    "test:rules:phase-k-e2e": "npm run generate:rules:phase-k-e2e && firebase emulators:exec --config firebase.phase-k-e2e.json --only firestore \"node --test --test-concurrency=1 firebase-tests/firestore.phase-k-e2e.rules.spec.js\"",
    "phase-k:preflight": "node scripts/runStorageV4PhaseKPreflight.mjs",
    "phase-k:telemetry:deploy-dev": "node scripts/deployStorageV4PhaseKTelemetryDev.mjs",
    "phase-k:telemetry:diagnose-dev": "node scripts/runStorageV4PhaseKTelemetryDiagnoseDev.mjs",
    "phase-k:observability:preflight": "node scripts/runStorageV4PhaseKObservabilityPreflight.mjs",
    "phase-k:observability:apply-dev": "node scripts/runStorageV4PhaseKObservabilityApplyDev.mjs",
    "phase-k:observability:checkpoint-dev": "node scripts/runStorageV4PhaseKObservabilityCheckpointDev.mjs",
    "phase-k:observability:cleanup-dashboard-dev": "node scripts/runStorageV4PhaseKDashboardCleanupDev.mjs",
    "phase-k:observability:create-email-channel-dev": "node scripts/runStorageV4PhaseKNotificationChannelEmailDev.mjs",
    "phase-k:observability:associate-channel-dev": "node scripts/runStorageV4PhaseKAlertPolicyChannelsDev.mjs",
    "phase-k:observability:enable-channel-dev": "node scripts/runStorageV4PhaseKNotificationChannelEnableDev.mjs",
    "phase-k:e2e:provider-outage-dev": "node scripts/runStorageV4PhaseKProviderOutageE2EDev.mjs",
    "phase-k:e2e:scoped-write-rules-dev": "node scripts/runStorageV4PhaseKScopedWriteRulesDev.mjs",
    "phase-k:e2e:scoped-write-rules-recover-dev": "node scripts/runStorageV4PhaseKScopedWriteRulesRecoveryDev.mjs",
    "phase-k:restore:preflight": "node scripts/runStorageV4PhaseKRestorePreflight.mjs",
    "phase-k:restore:drill-dev": "node scripts/runStorageV4PhaseKRestoreDrillDev.mjs",
    "phase-k:restore:checkpoint-dev": "node scripts/runStorageV4PhaseKRestoreCheckpointDev.mjs",
    "phase-k:restore:cleanup-dev": "node scripts/runStorageV4PhaseKRestoreCleanupDev.mjs",
    "phase-k:recovery:checkpoint-dev": "node scripts/runStorageV4PhaseKRecoveryCheckpointDev.mjs",
    "phase-k:budget:diagnose": "node scripts/runStorageV4PhaseKBudgetDiagnose.mjs",
    "phase-k:budget:plan": "node scripts/buildStorageV4PhaseKBudgetPlan.mjs",
    "phase-k:cost:scenarios": "node scripts/runStorageV4AtlasCostScenarios.mjs",
    "phase-k:resilience:local": "node --test functions/geoapifySupport.resilience.test.js test/sharedProviderCacheResilience.test.js test/storageV4ReconnectionStorm.test.js test/storageV4ReconnectCapacitySimulation.test.js test/storageV4MultiDeviceSimulation.test.js test/storageV4MultiDeviceContentionSimulation.test.js",
    "phase-k:slo:preflight": "node scripts/runStorageV4PhaseKSloPreflight.mjs",
    "phase-k:cloud-checkpoint": "node scripts/runStorageV4PhaseKCloudCheckpoint.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "firebase": "^12.17.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.25.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": "22.x"
  }
}
