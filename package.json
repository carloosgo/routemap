{
  "name": "travel-routes-app",
  "version": "0.1.0",
  "description": "Aplicación global de seguimiento de rutas de viaje y control de gastos. Arquitectura modular lista para escalar y migrar a móvil (iOS/Android).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test",
    "test:audit": "node scripts/auditTests.mjs",
    "test:impact": "node scripts/testImpact.mjs",
    "test:contracts": "node scripts/auditTests.mjs --enforce-baseline",
    "verify:local": "npm run test:impact && npm run test:contracts && npm test && npm run lint && npm run build",
    "preprod:hosting:deploy": "node scripts/runPreprodHostingDeploy.mjs",
    "generate:rules:gate-g-read": "node scripts/generateFirestoreGateGReadRules.mjs",
    "generate:rules:phase-k-e2e": "node scripts/generateFirestorePhaseKE2ERules.mjs",
    "generate:rules:pilot-write": "node scripts/generateFirestorePilotWriteRules.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test --test-concurrency=1 firebase-tests/firestore.rules.spec.js firebase-tests/internalCollections.rules.spec.js firebase-tests/firestore.v4.rules.spec.js firebase-tests/firestore.v4.internal.rules.spec.js firebase-tests/firestore.v4.repository.spec.js firebase-tests/firestore.v4.sync.spec.js firebase-tests/firestore.hybrid.rollout.spec.js firebase-tests/firestore.gate-g-read.rules.spec.js functions/v4AggregateStore.emulator.spec.js functions/v4TripLifecycleStore.emulator.spec.js functions/v4TripPurgeStore.emulator.spec.js functions/v4MigrationStore.emulator.spec.js functions/v4MigrationRollback.emulator.spec.js functions/v4MigrationLegacyV2.emulator.spec.js\"",
    "test:rules:phase-k-e2e": "npm run generate:rules:phase-k-e2e && firebase emulators:exec --config firebase.phase-k-e2e.json --only firestore \"node --test --test-concurrency=1 firebase-tests/firestore.phase-k-e2e.rules.spec.js\"",
    "storage-v4:migrate-trip-dev": "node functions/runV4MigrationDev.js",
    "storage-v4:rollback-trip-dev": "node functions/runV4MigrationRollbackDev.js",
    "storage-v4:pilot-plan-dev": "node scripts/runStorageV4PilotPlanDev.mjs",
    "storage-v4:pilot-stage-deploy-dev": "node scripts/runStorageV4PilotStageDeployDev.mjs",
    "storage-v4:pilot-lifecycle-deploy-dev": "node scripts/deployStorageV4TripLifecycleDev.mjs",
    "storage-v4:pilot-advance-dev": "node functions/runV4PilotAdvanceDev.js",
    "storage-v4:pilot-stage-verify-dev": "node scripts/runStorageV4PilotStageVerifyDev.mjs",
    "storage-v4:pilot-stage-safety-dev": "node scripts/runStorageV4PilotStageSafetyDev.mjs",
    "storage-v4:pilot-eventarc-iam-preflight-dev": "node scripts/runStorageV4PilotEventarcIamPreflightDev.mjs",
    "storage-v4:pilot-eventarc-iam-bootstrap-dev": "node scripts/runStorageV4PilotEventarcIamBootstrapDev.mjs",
    "storage-v4:pilot-eventarc-deploy-dev": "node scripts/runStorageV4PilotEventarcDeployDev.mjs",
    "storage-v4:pilot-remote-config-dev": "node scripts/runStorageV4PilotRemoteConfigDev.mjs",
    "storage-v4:dev-block-closeout": "node scripts/runStorageV4DevBlockCloseout.mjs",
    "storage-v4:dev:steady-state": "node scripts/runStorageV4DevSteadyState.mjs",
    "storage-v4:dev:preprod-parity": "node scripts/runStorageV4DevPreprodParity.mjs",
    "storage-v4:dev:platform-parity": "node scripts/runStorageV4DevPlatformParityPreflight.mjs",
    "storage-v4:dev:data-lifecycle": "node scripts/runStorageV4DevDataLifecycle.mjs",
    "phase-k:preflight": "node scripts/runStorageV4PhaseKPreflight.mjs",
    "phase-k:telemetry:deploy-dev": "node scripts/deployStorageV4PhaseKTelemetryDev.mjs",
    "phase-k:telemetry:diagnose-dev": "node scripts/runStorageV4PhaseKTelemetryDiagnoseDev.mjs",
    "phase-k:observability:preflight": "node scripts/runStorageV4PhaseKObservabilityPreflight.mjs",
    "phase-k:observability:apply-dev": "node scripts/runStorageV4PhaseKObservabilityApplyDev.mjs",
    "phase-k:observability:checkpoint-dev": "node scripts/runStorageV4PhaseKObservabilityCheckpointDev.mjs",
    "phase-k:observability:cleanup-dashboard-dev": "node scripts/runStorageV4PhaseKDashboardCleanupDev.mjs",
    "phase-k:observability:create-email-channel-dev": "node scripts/runStorageV4PhaseKNotificationChannelEmailDev.mjs",
    "phase-k:observability:associate-channel-dev": "node scripts/runStorageV4PhaseKAlertPolicyChannelsDev.mjs",
    "phase-k:observability:enable-channel-dev": "node scripts/runStorageV4PhaseKNotificationChannelEnableDev.mjs",
    "phase-k:observability:toggle-alerts-dev": "node scripts/runStorageV4PhaseKAlertPoliciesToggleDev.mjs",
    "phase-k:observability:alert-delivery-drill-dev": "node scripts/runStorageV4PhaseKAlertDeliveryDrillDev.mjs",
    "phase-k:e2e:provider-outage-dev": "node scripts/runStorageV4PhaseKProviderOutageE2EDev.mjs",
    "phase-k:e2e:scoped-write-rules-dev": "node scripts/runStorageV4PhaseKScopedWriteRulesDev.mjs",
    "phase-k:e2e:scoped-write-rules-recover-dev": "node scripts/runStorageV4PhaseKScopedWriteRulesRecoveryDev.mjs",
    "phase-k:e2e:cloud-load-dev": "node functions/runV4PhaseKCloudLoadDev.js",
    "phase-k:restore:preflight": "node scripts/runStorageV4PhaseKRestorePreflight.mjs",
    "phase-k:restore:drill-dev": "node scripts/runStorageV4PhaseKRestoreDrillDev.mjs",
    "phase-k:restore:checkpoint-dev": "node scripts/runStorageV4PhaseKRestoreCheckpointDev.mjs",
    "phase-k:restore:cleanup-dev": "node scripts/runStorageV4PhaseKRestoreCleanupDev.mjs",
    "phase-k:recovery:checkpoint-dev": "node scripts/runStorageV4PhaseKRecoveryCheckpointDev.mjs",
    "phase-k:budget:diagnose": "node scripts/runStorageV4PhaseKBudgetDiagnose.mjs",
    "phase-k:budget:plan": "node scripts/buildStorageV4PhaseKBudgetPlan.mjs",
    "phase-k:budget:apply-dev": "node scripts/runStorageV4PhaseKBudgetApplyDev.mjs",
    "phase-k:cost:scenarios": "node scripts/runStorageV4AtlasCostScenarios.mjs",
    "phase-k:resilience:local": "node --test functions/geoapifySupport.resilience.test.js test/sharedProviderCacheResilience.test.js test/storageV4ReconnectionStorm.test.js test/storageV4ReconnectCapacitySimulation.test.js test/storageV4MultiDeviceSimulation.test.js test/storageV4MultiDeviceContentionSimulation.test.js",
    "phase-k:slo:preflight": "node scripts/runStorageV4PhaseKSloPreflight.mjs",
    "phase-k:cloud-checkpoint": "node scripts/runStorageV4PhaseKCloudCheckpoint.mjs",
    "phase-l:l0:preflight": "node scripts/runStorageV4PhaseL0Preflight.mjs",
    "phase-l:l0:create-prod": "node scripts/runStorageV4PhaseL0CreateProductionProject.mjs",
    "phase-l:l1:preflight-prod": "node scripts/runStorageV4PhaseL1SecurityPreflightProd.mjs",
    "phase-l:l1:lock-rules-prod": "node scripts/runStorageV4PhaseL1LockRulesProd.mjs",
    "phase-l:l1:create-web-app-prod": "node scripts/runStorageV4PhaseL1CreateWebAppProd.mjs",
    "phase-l:l1:configure-google-auth-prod": "node scripts/runStorageV4PhaseL1ConfigureGoogleAuthProd.mjs",
    "phase-l:l2:preflight-prod": "node scripts/runStorageV4PhaseL2PreflightProd.mjs",
    "phase-l:l2:recovery-prod": "node scripts/runStorageV4PhaseL2RecoveryProd.mjs",
    "phase-l:l2:budget-prod": "node scripts/runStorageV4PhaseL2BudgetProd.mjs",
    "phase-l:l3:preflight-prod": "node scripts/runStorageV4PhaseL3PreflightProd.mjs",
    "phase-l:l4:read-plan-prod": "node scripts/runStorageV4PhaseL4ReadPlanProd.mjs",
    "phase-l:l5:materialization-plan-prod": "node scripts/runStorageV4PhaseL5MaterializationPlanProd.mjs",
    "phase-l:l6:write-plan-prod": "node scripts/runStorageV4PhaseL6WritePlanProd.mjs",
    "phase-l:l7:convergence-plan-prod": "node scripts/runStorageV4PhaseL7ConvergencePlanProd.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "firebase": "^12.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.25.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": "22.x"
  }
}
