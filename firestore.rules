rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validTripShape(data) {
      return data.keys().hasOnly([
          'id',
          'name',
          'currency',
          'segments',
          'notes',
          'checklist',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.name is string
        && data.name.size() <= 120
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$')
        && data.segments is list
        && data.segments.size() <= 500
        && data.notes is list
        && data.notes.size() <= 50
        && data.checklist is list
        && data.checklist.size() <= 500
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /trips/{tripId} {
        allow get, list: if ownsUserPath(userId);
        allow create: if ownsUserPath(userId)
          && request.resource.data.id == tripId
          && validTripShape(request.resource.data);
        allow update: if ownsUserPath(userId)
          && request.resource.data.id == tripId
          && resource.data.id == tripId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTripShape(request.resource.data);
        allow delete: if ownsUserPath(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
