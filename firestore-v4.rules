rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validCount(value, maximum) {
      return value is int && value >= 0 && value <= maximum;
    }

    function validAmount(value) {
      return value is number && value >= 0;
    }

    function validRank(value) {
      return value is string && value.matches('^[0-9a-z]{10}$');
    }

    function validStatus(value) {
      return value == 'active' || value == 'deleted';
    }

    function validLifecycle(data) {
      return validStatus(data.status)
        && data.version is int
        && data.version >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.deletedAt == null || data.deletedAt is timestamp);
    }

    function validCity(data) {
      return data is map
        && data.keys().hasOnly([
          'id', 'name', 'displayName', 'country', 'countryCode', 'lat', 'lon'
        ])
        && data.id is string
        && data.id.size() <= 256
        && data.name is string
        && data.name.size() <= 120
        && data.displayName is string
        && data.displayName.size() <= 200
        && data.country is string
        && data.country.size() <= 100
        && data.countryCode is string
        && data.countryCode.matches('^([A-Z]{2})?$')
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lon is number
        && data.lon >= -180
        && data.lon <= 180;
    }

    function validFood(data) {
      return data is map
        && data.keys().hasOnly(['mode', 'single', 'breakfast', 'lunch', 'dinner'])
        && data.keys().hasAll(['mode', 'single', 'breakfast', 'lunch', 'dinner'])
        && (data.mode == 'single' || data.mode == 'detailed')
        && validAmount(data.single)
        && validAmount(data.breakfast)
        && validAmount(data.lunch)
        && validAmount(data.dinner);
    }

    function validTransport(data) {
      return data is map
        && data.keys().hasOnly(['plane', 'train', 'bus', 'taxiUber'])
        && data.keys().hasAll(['plane', 'train', 'bus', 'taxiUber'])
        && validAmount(data.plane)
        && validAmount(data.train)
        && validAmount(data.bus)
        && validAmount(data.taxiUber);
    }

    function validExpenseItems(items) {
      return items is list && items.size() <= 200;
    }

    function validExpenses(data) {
      return data is map
        && data.keys().hasOnly([
          'lodging', 'food', 'transport', 'transportOthers', 'attractions', 'others'
        ])
        && data.keys().hasAll([
          'lodging', 'food', 'transport', 'transportOthers', 'attractions', 'others'
        ])
        && validAmount(data.lodging)
        && validFood(data.food)
        && validTransport(data.transport)
        && validExpenseItems(data.transportOthers)
        && validExpenseItems(data.attractions)
        && validExpenseItems(data.others);
    }

    function validOriginDetails(data) {
      return data is map
        && data.keys().hasOnly(['departureDate', 'expenses', 'note'])
        && data.keys().hasAll(['departureDate', 'expenses'])
        && data.departureDate is string
        && data.departureDate.size() <= 10
        && (
          !data.keys().hasAny(['note'])
          || (data.note is string && data.note.size() <= 500)
        )
        && validExpenses(data.expenses);
    }

    function tripPath(userId, tripId) {
      return /databases/$(database)/documents/users/$(userId)/trips/$(tripId);
    }

    function activeTripExists(userId, tripId) {
      return exists(tripPath(userId, tripId))
        && get(tripPath(userId, tripId)).data.schemaVersion == 4
        && get(tripPath(userId, tripId)).data.status == 'active';
    }

    function validTrip(data, tripId) {
      return data.keys().hasOnly([
          'id', 'name', 'currency', 'originDetails', 'schemaVersion', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt', 'purgeAfter',
          'segmentCount', 'placeCount', 'total'
        ])
        && data.keys().hasAll([
          'id', 'name', 'currency', 'schemaVersion', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt', 'purgeAfter',
          'segmentCount', 'placeCount', 'total'
        ])
        && data.id == tripId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && data.name is string
        && data.name.size() <= 120
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$')
        && (
          !data.keys().hasAny(['originDetails'])
          || validOriginDetails(data.originDetails)
        )
        && data.schemaVersion == 4
        && validLifecycle(data)
        && (data.purgeAfter == null || data.purgeAfter is timestamp)
        && validCount(data.segmentCount, 500)
        && validCount(data.placeCount, 500)
        && validAmount(data.total);
    }

    function validClientTripCreate(data, tripId) {
      return validTrip(data, tripId)
        && data.status == 'active'
        && data.version == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.deletedAt == null
        && data.purgeAfter == null
        && data.segmentCount == 0
        && data.placeCount == 0
        && data.total == 0;
    }

    function validClientTripUpdate() {
      return validTrip(request.resource.data, resource.id)
        && resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deletedAt == resource.data.deletedAt
        && request.resource.data.purgeAfter == resource.data.purgeAfter
        && request.resource.data.segmentCount == resource.data.segmentCount
        && request.resource.data.placeCount == resource.data.placeCount
        && request.resource.data.total == resource.data.total
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'currency', 'originDetails', 'version', 'updatedAt'
        ]);
    }

    function validEntityCreate(data) {
      return validLifecycle(data)
        && data.status == 'active'
        && data.version == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.deletedAt == null;
    }

    function validEntityUpdate() {
      return validLifecycle(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.deletedAt == null
          )
          ||
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'deleted'
            && request.resource.data.deletedAt == request.time
          )
          ||
          (
            resource.data.status == 'deleted'
            && request.resource.data.status == 'active'
            && request.resource.data.deletedAt == null
          )
        );
    }

    function validSegment(data, segmentId) {
      return data.keys().hasOnly([
          'id', 'rank', 'origin', 'destination', 'startDate', 'endDate',
          'expenses', 'note', 'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'id', 'rank', 'origin', 'destination', 'startDate', 'endDate',
          'expenses', 'note', 'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.id == segmentId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && validRank(data.rank)
        && (data.origin == null || validCity(data.origin))
        && (data.destination == null || validCity(data.destination))
        && data.startDate is string
        && data.startDate.size() <= 10
        && data.endDate is string
        && data.endDate.size() <= 10
        && validExpenses(data.expenses)
        && data.note is string
        && data.note.size() <= 500
        && validLifecycle(data);
    }

    function validPlace(data, placeId) {
      return data.keys().hasOnly([
          'id', 'rank', 'provider', 'googlePlaceId', 'userLabel', 'name', 'address',
          'city', 'country', 'category', 'countryCode', 'lat', 'lon', 'savedAt',
          'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'id', 'rank', 'provider', 'googlePlaceId', 'userLabel', 'name', 'address',
          'city', 'country', 'category', 'countryCode', 'lat', 'lon', 'savedAt',
          'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.id == placeId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && validRank(data.rank)
        && data.provider is string
        && (data.provider == 'geoapify' || data.provider == 'google')
        && data.googlePlaceId is string
        && data.googlePlaceId.size() <= 256
        && data.userLabel is string
        && data.userLabel.size() <= 160
        && data.name is string
        && data.name.size() <= 160
        && data.address is string
        && data.address.size() <= 260
        && data.city is string
        && data.city.size() <= 120
        && data.country is string
        && data.country.size() <= 100
        && data.category is string
        && data.category.size() <= 80
        && data.countryCode is string
        && data.countryCode.matches('^([A-Z]{2})?$')
        && data.savedAt is string
        && data.savedAt.size() <= 40
        && validLifecycle(data)
        && (
          (
            data.provider == 'google'
            && data.googlePlaceId.size() > 0
            && data.name == ''
            && data.address == ''
            && data.city == ''
            && data.country == ''
            && data.category == ''
            && data.countryCode == ''
            && data.lat == null
            && data.lon == null
          )
          ||
          (
            data.provider == 'geoapify'
            && data.googlePlaceId == ''
            && data.lat is number
            && data.lat >= -90
            && data.lat <= 90
            && data.lon is number
            && data.lon >= -180
            && data.lon <= 180
          )
        );
    }

    function validConnection(data, connectionId) {
      return data.keys().hasOnly([
          'id', 'rank', 'fromPlaceId', 'toPlaceId', 'mode', 'visible',
          'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'id', 'rank', 'fromPlaceId', 'toPlaceId', 'mode', 'visible',
          'status', 'version', 'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.id == connectionId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && validRank(data.rank)
        && data.fromPlaceId is string
        && data.fromPlaceId.size() > 0
        && data.fromPlaceId.size() <= 128
        && data.toPlaceId is string
        && data.toPlaceId.size() > 0
        && data.toPlaceId.size() <= 128
        && data.fromPlaceId != data.toPlaceId
        && data.mode is string
        && (
          data.mode == 'drive'
          || data.mode == 'transit'
          || data.mode == 'train'
          || data.mode == 'bus'
          || data.mode == 'bicycle'
          || data.mode == 'walk'
        )
        && data.visible is bool
        && validLifecycle(data);
    }

    function validNote(data, noteId) {
      return data.keys().hasOnly([
          'id', 'rank', 'title', 'text', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'id', 'rank', 'title', 'text', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.id == noteId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && validRank(data.rank)
        && data.title is string
        && data.title.size() <= 60
        && data.text is string
        && data.text.size() <= 2000
        && validLifecycle(data);
    }

    function validChecklist(data, itemId) {
      return data.keys().hasOnly([
          'id', 'rank', 'text', 'done', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.keys().hasAll([
          'id', 'rank', 'text', 'done', 'status', 'version',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.id == itemId
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && validRank(data.rank)
        && data.text is string
        && data.text.size() <= 120
        && data.done is bool
        && validLifecycle(data);
    }

    match /users/{userId} {
      allow read, write: if false;

      match /trips/{tripId} {
        allow get, list: if ownsUserPath(userId);
        allow create: if ownsUserPath(userId)
          && validClientTripCreate(request.resource.data, tripId);
        allow update: if ownsUserPath(userId) && validClientTripUpdate();
        allow delete: if false;

        match /segments/{segmentId} {
          allow get, list: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validSegment(request.resource.data, segmentId)
            && validEntityCreate(request.resource.data);
          allow update: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validSegment(request.resource.data, segmentId)
            && validEntityUpdate();
          allow delete: if false;
        }

        match /places/{placeId} {
          allow get, list: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validPlace(request.resource.data, placeId)
            && validEntityCreate(request.resource.data);
          allow update: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validPlace(request.resource.data, placeId)
            && validEntityUpdate();
          allow delete: if false;
        }

        match /connections/{connectionId} {
          allow get, list: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validConnection(request.resource.data, connectionId)
            && validEntityCreate(request.resource.data);
          allow update: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validConnection(request.resource.data, connectionId)
            && validEntityUpdate();
          allow delete: if false;
        }

        match /notes/{noteId} {
          allow get, list: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validNote(request.resource.data, noteId)
            && validEntityCreate(request.resource.data);
          allow update: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validNote(request.resource.data, noteId)
            && validEntityUpdate();
          allow delete: if false;
        }

        match /checklist/{itemId} {
          allow get, list: if ownsUserPath(userId);
          allow create: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validChecklist(request.resource.data, itemId)
            && validEntityCreate(request.resource.data);
          allow update: if ownsUserPath(userId)
            && activeTripExists(userId, tripId)
            && validChecklist(request.resource.data, itemId)
            && validEntityUpdate();
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
