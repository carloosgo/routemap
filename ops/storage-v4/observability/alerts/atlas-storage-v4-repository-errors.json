{
  "displayName": "Atlas Storage v4 — repository errors — dev",
  "combiner": "OR",
  "enabled": false,
  "notificationChannels": [],
  "documentation": {
    "content": "Disabled Phase K template. Fires when repository rollout telemetry reports any error in a 5-minute alignment window. Enable only after the metric is created, baseline is reviewed, and a notification channel/owner is approved.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "system": "atlas-storage-v4",
    "environment": "dev",
    "phase": "k"
  },
  "conditions": [
    {
      "displayName": "Repository error count > 0 in 5m",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/atlas_storage_v4_rollout_events\" AND metric.labels.outcome=\"error\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ]
}
