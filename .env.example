# Copia este archivo a .env.local y ajusta los valores.
VITE_STORAGE_DRIVER=local
VITE_API_BASE_URL=https://api.tu-dominio.com

# Firebase Web SDK (configuración pública)
VITE_FIREBASE_API_KEY=tu_api_key_publica
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Clave pública de sitio de reCAPTCHA Enterprise para Firebase App Check.
# Se agrega únicamente después de registrar la app web en Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=tu_clave_publica_recaptcha_enterprise

# Itinerario / Tramos conserva MapLibre + Geoapify.
# Esta clave pública debe estar restringida para el uso web permitido.
VITE_GEOAPIFY_MAPS_API_KEY=tu_clave_publica_restringida
VITE_GEOAPIFY_MAP_STYLE=positron

# Mis Rutas / Lugares usa Google Maps JavaScript API.
# La key es pública y debe restringirse por HTTP referrer y exclusivamente a Maps JavaScript API.
# El Map ID identifica el estilo administrado en Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=tu_clave_web_google_restringida
VITE_GOOGLE_MAPS_MAP_ID=tu_map_id_google

# Opcional. Por defecto la app resuelve automáticamente mediante Overture STAC
# el archivo PMTiles de divisiones de la versión vigente para Itinerario.
# VITE_COUNTRY_BOUNDARIES_PMTILES_URL=https://tu-cdn.example.com/divisions.pmtiles

VITE_DEFAULT_LOCALE=es

# Configuración backend en Firebase Secret Manager:
# GEOAPIFY_CITY_API_KEY: autocompletado de ciudades de Itinerario.
# GEOAPIFY_API_KEY: Functions Geoapify legadas/auxiliares que siguen desplegadas.
# GOOGLE_PLACES_API_KEY: exclusivamente Places API (New); nunca va en frontend.
# GOOGLE_ROUTES_API_KEY: exclusivamente Routes API; nunca va en frontend.
#
# Comandos de creación/rotación (no pegues valores en archivos ni en el repositorio):
# firebase functions:secrets:set GEOAPIFY_CITY_API_KEY --project atlasmap-dev
# firebase functions:secrets:set GEOAPIFY_API_KEY --project atlasmap-dev
# firebase functions:secrets:set GOOGLE_PLACES_API_KEY --project atlasmap-dev
# firebase functions:secrets:set GOOGLE_ROUTES_API_KEY --project atlasmap-dev
#
# App Check permanece desactivado hasta completar registro, configuración y observación.
# Los archivos functions/.env* están ignorados por Git y no deben contener secretos.
