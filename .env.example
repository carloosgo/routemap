# Copia este archivo a .env.local y ajusta los valores.
# Las variables expuestas al cliente DEBEN llevar el prefijo VITE_.
# NUNCA pongas secretos (claves privadas, cuentas de servicio o tokens admin)
# en variables VITE_, porque quedan visibles en el bundle del navegador.

# Driver de almacenamiento: "local" (localStorage) | "firestore" | "api"
VITE_STORAGE_DRIVER=local

# URL base del backend (solo si VITE_STORAGE_DRIVER=api)
VITE_API_BASE_URL=https://api.tu-dominio.com

# Firebase Web SDK — configuración pública del proyecto.
VITE_FIREBASE_API_KEY=tu_api_key_publica
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# En desarrollo local puede conectarse a Auth y Firestore Emulator.
VITE_FIREBASE_USE_EMULATORS=false

# Proveedor de geocodificación: "nominatim" (default) | "mapbox" (a implementar)
VITE_GEOCODER=nominatim

# REQUERIDO — Token público de Mapbox GL JS.
# Obtenlo en https://account.mapbox.com → "Access tokens" → "Default public token".
VITE_MAPBOX_TOKEN=tu_token_de_mapbox_aqui

# Opcional — Estilo del mapa Mapbox. Si se omite, usa light-v11.
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Idioma por defecto: "es" | "en"
VITE_DEFAULT_LOCALE=es
